# Optional story metadata storage. Cake/playback no longer needs Redis.
# Server-only Upstash REST credentials. Never put these in browser JavaScript.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=save-the-dates

# Administration, legacy Blob storage and cake state.
ADMIN_PASSWORD=
BLOB_READ_WRITE_TOKEN=
CAKE_RESET_PASSWORD=

# Optional Cloudflare R2 media storage. Set all four values to use R2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
