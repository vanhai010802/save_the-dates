# Server-only Upstash REST credentials. Never put these in browser JavaScript.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=save-the-dates

# Existing credentials are still needed for administration and media uploads.
ADMIN_PASSWORD=
BLOB_READ_WRITE_TOKEN=
